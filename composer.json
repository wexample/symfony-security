{
  "name": "wexample/symfony-security",
  "description": "Security contracts shared by the Symfony packages: secret redaction in logs, security events",
  "version": "1.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonySecurity\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonySecurity\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "psr/log": "^3.0",
    "monolog/monolog": "^3.5",
    "wexample/symfony-helpers": ">=12.0.0",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/event-dispatcher": "^7.4 || ^8.0",
    "symfony/http-foundation": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/yaml": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "*",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/monolog-bundle": "^3.10"
  },
  "suggest": {
    "symfony/monolog-bundle": "Registers the redaction processor on every channel, and the security journals' channels"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
